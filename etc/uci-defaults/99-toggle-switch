#!/bin/sh

# Image-builder installations skip package postinst while assembling rootfs.
# Complete the device-specific setup on the first boot instead.
reset='/etc/rc.button/reset'
backup='/etc/rc.button/reset.x1pro-stock'
custom='/usr/libexec/x1pro-reset-button'

if [ -x "$custom" ] && ! cmp -s "$reset" "$custom"; then
	[ ! -e "$reset" ] || [ -e "$backup" ] || cp "$reset" "$backup"
	cp "$custom" "$reset"
	chmod 0755 "$reset"
fi

/etc/init.d/x1pro-toggle enable
/etc/init.d/x1pro-toggle restart
rm -f /tmp/luci-indexcache

exit 0
